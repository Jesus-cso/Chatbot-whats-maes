# Gemini (aistudio.google.com > Get API key)
GEMINI_API_KEY=pon_tu_api_key_aqui
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash

# Documentos que lee el bot (solo info publica para aspirantes)
DOCS_DIR=documentos/aspirantes

# Twilio (consola de Twilio > Account Info)
TWILIO_AUTH_TOKEN=pon_tu_auth_token_aqui

# URL publica de Render, SIN "/" al final
PUBLIC_URL=https://tu-bot.onrender.com
VALIDATE_TWILIO=true

# Sal para anonimizar telefonos en el registro (texto largo y secreto)
PHONE_SALT=cambia_esto_por_un_texto_largo